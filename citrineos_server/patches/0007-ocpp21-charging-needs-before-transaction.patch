+  // ha-citrine patch (0007-ocpp21-charging-needs-before-transaction): ISO 15118-20
+  // needs can arrive before TransactionEvent Started. Store them on the EVSE without
+  // a transaction; linkPendingChargingNeeds attaches them when the transaction starts.
+  async createPendingChargingNeeds(
+    tenantId: number,
+    chargingNeedsReq: OCPP2_0_1.NotifyEVChargingNeedsRequest,
+    ocppConnectionName: string,
+  ): Promise<ChargingNeeds> {
+    const evse = await Evse.findOne({
+      where: {
+        tenantId,
+        stationId: await stationIdFilter(tenantId, ocppConnectionName),
+        evseTypeId: chargingNeedsReq.evseId,
+      },
+    });
+    if (!evse) {
+      throw new Error(`No evse ${chargingNeedsReq.evseId} found on station ${ocppConnectionName}`);
+    }
+
+    return await this.chargingNeeds.create(
+      tenantId,
+      ChargingNeeds.build({
+        tenantId,
+        ...chargingNeedsReq.chargingNeeds,
+        evseId: evse.id,
+        transactionDatabaseId: null,
+        maxScheduleTuples: chargingNeedsReq.maxScheduleTuples,
+      }),
+    );
+  }
+
+  async linkPendingChargingNeeds(
+    tenantId: number,
+    evseDBId: number,
+    transactionDatabaseId: number,
+    receivedSince: Date,
+  ): Promise<ChargingNeeds | undefined> {
+    const pending = await this.chargingNeeds.readAllByQuery(tenantId, {
+      where: {
+        evseId: evseDBId,
+        transactionDatabaseId: null,
+        createdAt: { [Op.gte]: receivedSince },
+      },
+      order: [['createdAt', 'DESC']],
+    });
+    if (pending.length === 0) {
+      return undefined;
+    }
+    const latest = pending[0];
+    // transactionCreatedAt is part of the primary key, so the linked needs are a new row.
+    const linked = await this.chargingNeeds.create(
+      tenantId,
+      ChargingNeeds.build({
+        tenantId,
+        acChargingParameters: latest.acChargingParameters,
+        dcChargingParameters: latest.dcChargingParameters,
+        v2xChargingParameters: latest.v2xChargingParameters,
+        departureTime: latest.departureTime,
+        requestedEnergyTransfer: latest.requestedEnergyTransfer,
+        controlMode: latest.controlMode,
+        mobilityNeedsMode: latest.mobilityNeedsMode,
+        maxScheduleTuples: latest.maxScheduleTuples,
+        evseId: evseDBId,
+        transactionDatabaseId,
+      }),
+    );
+    await ChargingNeeds.destroy({
+      where: { tenantId, evseId: evseDBId, transactionDatabaseId: null },
+    });
+    return linked;
+  }
+
   async findChargingNeedsByEvseDBIdAndTransactionDBId(
     tenantId: number,
     evseDBId: number,
