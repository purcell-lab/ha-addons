+const DER_ACTIONS = [
+  OCPP_CallAction.SetDERControl,
+  OCPP_CallAction.GetDERControl,
+  OCPP_CallAction.ClearDERControl,
+  OCPP_CallAction.ReportDERControl,
+  OCPP_CallAction.NotifyDERStartStop,
+  OCPP_CallAction.NotifyDERAlarm,
