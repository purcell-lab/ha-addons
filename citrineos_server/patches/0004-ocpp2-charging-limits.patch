+// SPDX-FileCopyrightText: 2026 Contributors to the CitrineOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+import type { OCPP2_request_types } from '@citrineos/types';
+import type { Transaction, WhereOptions } from 'sequelize';
+import { ChargingLimit } from '../../models/charging-limit.js';
+import type { IChargingLimitRepository } from '../repositories.js';
+import { SequelizeRepository, type SequelizeRepositoryDependencies } from './base.js';
+import { resolveStationIdOrThrow } from './resolve-station-id.js';
+
+// ha-citrine patch (0004-ocpp2-charging-limits)
+export class SequelizeChargingLimitRepository
+  extends SequelizeRepository<ChargingLimit>
+  implements IChargingLimitRepository
+{
+  constructor({ config, logger, sequelizeInstance }: SequelizeRepositoryDependencies) {
+    super({ config, namespace: ChargingLimit.MODEL_NAME, logger, sequelizeInstance });
+  }
+
+  async createByStationId(
+    tenantId: number,
+    value: OCPP2_request_types.NotifyChargingLimitRequest,
+    ocppConnectionName: string,
+  ): Promise<ChargingLimit> {
+    const { chargingLimit } = value;
+    const evseId = value.evseId ?? null;
+
+    const [cleared, created] = await this.s.transaction(async (transaction) => {
+      const stationId = await resolveStationIdOrThrow(
+        tenantId,
+        ocppConnectionName,
+        'store charging limit',
+        transaction,
+      );
+      const deactivated = await this.deactivate(
+        {
+          tenantId,
+          stationId,
+          evseId,
+          chargingLimitSource: chargingLimit.chargingLimitSource,
+          isActive: true,
+        },
+        transaction,
+      );
+      const row = await ChargingLimit.create(
+        {
+          tenantId,
+          stationId,
+          evseId,
+          chargingLimitSource: chargingLimit.chargingLimitSource,
+          isGridCritical: chargingLimit.isGridCritical ?? null,
+          isLocalGeneration:
+            'isLocalGeneration' in chargingLimit ? (chargingLimit.isLocalGeneration ?? null) : null,
+          chargingSchedule: value.chargingSchedule ?? null,
+          isActive: true,
+          clearedAt: null,
+        },
+        { transaction },
+      );
+      return [deactivated, row] as const;
+    });
+
+    if (cleared.length > 0) {
+      this.emit('updated', cleared);
+    }
+    this.emit('created', [created]);
+    return created;
+  }
+
+  async clearByStationId(
+    tenantId: number,
+    value: OCPP2_request_types.ClearedChargingLimitRequest,
+    ocppConnectionName: string,
+  ): Promise<number> {
+    const cleared = await this.s.transaction(async (transaction) => {
+      const stationId = await resolveStationIdOrThrow(
+        tenantId,
+        ocppConnectionName,
+        'clear charging limit',
+        transaction,
+      );
+      return this.deactivate(
+        {
+          tenantId,
+          stationId,
+          chargingLimitSource: value.chargingLimitSource,
+          isActive: true,
+          ...(value.evseId != null ? { evseId: value.evseId } : {}),
+        },
+        transaction,
+      );
+    });
+
+    if (cleared.length > 0) {
+      this.emit('updated', cleared);
+    }
+    return cleared.length;
+  }
+
+  private async deactivate(
+    where: WhereOptions<ChargingLimit>,
+    transaction: Transaction,
+  ): Promise<ChargingLimit[]> {
+    const [, rows] = await ChargingLimit.update(
+      { isActive: false, clearedAt: new Date().toISOString() },
+      { where, transaction, returning: true },
+    );
+    return rows;
+  }
+}
+
+export default SequelizeChargingLimitRepository;
