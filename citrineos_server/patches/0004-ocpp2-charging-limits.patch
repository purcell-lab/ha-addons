+// SPDX-FileCopyrightText: 2026 Contributors to the CitrineOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+
+import type { ChargingLimitDto, OCPP2_request_types } from '@citrineos/types';
+import { and, eq, isNull, type SQL } from 'drizzle-orm';
+import { chargingStationTable } from '../../db/drizzle/schema/charging-station.js';
+import {
+  type ChargingLimitEntity,
+  chargingLimitTable,
+} from '../../db/drizzle/schema/charging-limit.js';
+import { type Explicit } from '../../db/drizzle/types.js';
+import type { IChargingLimitRepository } from '../repositories.js';
+import { type DrizzleExecutor, DrizzleRepository, type DrizzleWriteContext } from './base.js';
+
+// ha-citrine patch (0004-ocpp2-charging-limits)
+export function toChargingLimitDto(entity: ChargingLimitEntity): ChargingLimitDto {
+  const dto: Explicit<ChargingLimitDto> = {
+    id: entity.id,
+    stationId: entity.stationId,
+    evseId: entity.evseId ?? null,
+    chargingLimitSource: entity.chargingLimitSource,
+    isGridCritical: entity.isGridCritical ?? null,
+    isLocalGeneration: entity.isLocalGeneration ?? null,
+    chargingSchedule: entity.chargingSchedule ?? null,
+    isActive: entity.isActive,
+    clearedAt: entity.clearedAt?.toISOString() ?? null,
+    tenantId: entity.tenantId,
+    tenant: undefined,
+    createdAt: entity.createdAt,
+    updatedAt: entity.updatedAt,
+  };
+  return dto;
+}
+
+export class DrizzleChargingLimitRepository
+  extends DrizzleRepository<typeof chargingLimitTable, ChargingLimitDto>
+  implements IChargingLimitRepository
+{
+  // No schema-per-tenant variant: the charging limit table is row-level only.
+  protected getTable(_tenantId: number): typeof chargingLimitTable {
+    return chargingLimitTable;
+  }
+
+  protected toDto(row: ChargingLimitEntity): ChargingLimitDto {
+    return toChargingLimitDto(row);
+  }
+
+  async createByStationId(
+    tenantId: number,
+    value: OCPP2_request_types.NotifyChargingLimitRequest,
+    ocppConnectionName: string,
+  ): Promise<ChargingLimitDto> {
+    const { chargingLimit } = value;
+    const evseId = value.evseId ?? null;
+
+    return this.withAtomicWrite(async (ctx) => {
+      const stationId = await this.findStationIdOrThrow(
+        tenantId,
+        ocppConnectionName,
+        'store charging limit',
+        ctx.db,
+      );
+      await this.deactivate(
+        tenantId,
+        [
+          eq(chargingLimitTable.stationId, stationId),
+          evseId === null
+            ? isNull(chargingLimitTable.evseId)
+            : eq(chargingLimitTable.evseId, evseId),
+          eq(chargingLimitTable.chargingLimitSource, chargingLimit.chargingLimitSource),
+        ],
+        ctx,
+      );
+      return this.insert(
+        tenantId,
+        {
+          stationId,
+          evseId,
+          chargingLimitSource: chargingLimit.chargingLimitSource,
+          isGridCritical: chargingLimit.isGridCritical ?? null,
+          isLocalGeneration:
+            'isLocalGeneration' in chargingLimit ? (chargingLimit.isLocalGeneration ?? null) : null,
+          chargingSchedule: value.chargingSchedule ?? null,
+          isActive: true,
+          clearedAt: null,
+        } satisfies Omit<typeof chargingLimitTable.$inferInsert, 'tenantId'>,
+        ctx,
+      );
+    });
+  }
+
+  async clearByStationId(
+    tenantId: number,
+    value: OCPP2_request_types.ClearedChargingLimitRequest,
+    ocppConnectionName: string,
+  ): Promise<number> {
+    return this.withAtomicWrite(async (ctx) => {
+      const stationId = await this.findStationIdOrThrow(
+        tenantId,
+        ocppConnectionName,
+        'clear charging limit',
+        ctx.db,
+      );
+      const conditions = [
+        eq(chargingLimitTable.stationId, stationId),
+        eq(chargingLimitTable.chargingLimitSource, value.chargingLimitSource),
+      ];
+      if (value.evseId != null) {
+        conditions.push(eq(chargingLimitTable.evseId, value.evseId));
+      }
+      return this.deactivate(tenantId, conditions, ctx);
+    });
+  }
+
+  private async findStationIdOrThrow(
+    tenantId: number,
+    ocppConnectionName: string,
+    purpose: string,
+    db: DrizzleExecutor,
+  ): Promise<number> {
+    const rows = await db
+      .select({ id: chargingStationTable.id })
+      .from(chargingStationTable)
+      .where(
+        and(
+          eq(chargingStationTable.ocppConnectionName, ocppConnectionName),
+          eq(chargingStationTable.tenantId, tenantId),
+        ),
+      )
+      .limit(1);
+    const stationId = rows[0]?.id;
+    if (stationId === undefined) {
+      throw new Error(
+        `Cannot ${purpose}: no charging station named ` +
+          `'${ocppConnectionName}' exists in tenant ${tenantId}.`,
+      );
+    }
+    return stationId;
+  }
+
+  private async deactivate(
+    tenantId: number,
+    conditions: SQL[],
+    ctx: DrizzleWriteContext,
+  ): Promise<number> {
+    const now = new Date();
+    const rows = await ctx.db
+      .update(chargingLimitTable)
+      .set({ isActive: false, clearedAt: now, updatedAt: now })
+      .where(
+        and(
+          eq(chargingLimitTable.tenantId, tenantId),
+          eq(chargingLimitTable.isActive, true),
+          ...conditions,
+        ),
+      )
+      .returning();
+    if (rows.length > 0) {
+      this.raise(
+        ctx,
+        'updated',
+        rows.map((row) => this.toDto(row)),
+      );
+    }
+    return rows.length;
+  }
+}
