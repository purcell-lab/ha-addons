+
+import { TableName } from '@dal/models/table-name.js';
+import {
+  boolean,
+  index,
+  integer,
+  jsonb,
+  pgTable,
+  serial,
+  timestamp,
+  varchar,
+} from 'drizzle-orm/pg-core';
+import { createInsertSchema, createSelectSchema } from 'drizzle-zod';
+import { type z } from 'zod';
+
+// ha-citrine patch (0004-ocpp2-charging-limits)
+export const chargingLimitTable = pgTable(
+  TableName.ChargingLimits,
+  {
+    id: serial('id').primaryKey(),
+    stationId: integer('stationId').notNull(),
+    evseId: integer('evseId'),
+    chargingLimitSource: varchar('chargingLimitSource', { length: 20 }).notNull(),
+    isGridCritical: boolean('isGridCritical'),
+    isLocalGeneration: boolean('isLocalGeneration'),
+    chargingSchedule: jsonb('chargingSchedule').$type<unknown[]>(),
+    isActive: boolean('isActive').default(true).notNull(),
+    // mode: 'date' returns a JS Date — mapped to ISO string in the repository layer
+    clearedAt: timestamp('clearedAt', { withTimezone: true, mode: 'date' }),
+    tenantId: integer('tenantId').notNull(),
+    createdAt: timestamp('createdAt', { withTimezone: true, mode: 'date' })
+      .notNull()
+      .$defaultFn(() => new Date()),
+    updatedAt: timestamp('updatedAt', { withTimezone: true, mode: 'date' })
+      .notNull()
+      .$defaultFn(() => new Date()),
+  },
+  (t) => [
+    index('charging_limits_tenant_id_station_id_is_active').on(t.tenantId, t.stationId, t.isActive),
+  ],
+);
+
+// ─── Zod schemas (runtime validation + type inference) ───────────────────────
+
+export const ChargingLimitEntitySchema = createSelectSchema(chargingLimitTable);
+export const ChargingLimitEntityInsertSchema = createInsertSchema(chargingLimitTable);
+
+export type ChargingLimitEntity = z.infer<typeof ChargingLimitEntitySchema>;
+export type ChargingLimitEntityInsert = z.infer<typeof ChargingLimitEntityInsertSchema>;
