+// SPDX-FileCopyrightText: 2026 Contributors to the CitrineOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+
+import { z } from 'zod';
+import { BaseSchema } from './types/base-dto.js';
+
+// ha-citrine patch (0004-ocpp2-charging-limits): a limit reported by NotifyChargingLimit.
+export const ChargingLimitSchema = BaseSchema.extend({
+  id: z.number().int().optional(),
+  stationId: z.number().int(),
+  evseId: z.number().int().nullable().optional(),
+  // OCPP 2.1 widens the 2.0.1 enum to any string of up to 20 characters.
+  chargingLimitSource: z.string().max(20),
+  isGridCritical: z.boolean().nullable().optional(),
+  isLocalGeneration: z.boolean().nullable().optional(),
+  // The request's chargingSchedule array, stored as the station sent it.
+  chargingSchedule: z.array(z.unknown()).nullable().optional(),
+  isActive: z.boolean(),
+  clearedAt: z.iso.datetime().nullable().optional(),
+});
+
+export const ChargingLimitProps = ChargingLimitSchema.keyof().enum;
+
+export type ChargingLimitDto = z.infer<typeof ChargingLimitSchema>;
+
+export const ChargingLimitCreateSchema = ChargingLimitSchema.omit({
+  id: true,
+  tenant: true,
+  updatedAt: true,
+  createdAt: true,
+});
+
+export type ChargingLimitCreate = z.infer<typeof ChargingLimitCreateSchema>;
+
+export const chargingLimitSchemas = {
+  ChargingLimit: ChargingLimitSchema,
+  ChargingLimitCreate: ChargingLimitCreateSchema,
+};
