+// SPDX-FileCopyrightText: 2026 Contributors to the CitrineOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// ha-citrine patch (0004-ocpp2-charging-limits)
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { DEFAULT_TENANT_ID, Message } from '@citrineos/base';
+import type { IChargingLimitRepository } from '@citrineos/dal';
+import {
+  type CallAction,
+  type ChargingLimitDto,
+  EventGroup,
+  MessageOrigin,
+  MessageState,
+  OCPP2_0_1,
+  OCPP2_1,
+  OCPP2_request_types,
+  OCPP_CallAction,
+  type OcppRequest,
+  OCPPVersion,
+} from '@citrineos/types';
+import {
+  ClearedChargingLimitRequestOcpp2Handler,
+  NotifyChargingLimitRequestOcpp2Handler,
+} from '@handlers/index.js';
+import { createTestContainer, makeMockOcppSender, mockDeps } from '@test/test-container.js';
+
+const STATION = 'station-001';
+const STATION_ID = 42;
+
+function aMessage<T extends OcppRequest>(
+  payload: T,
+  action: CallAction,
+  protocol: OCPPVersion = OCPPVersion.OCPP2_1,
+): Message<T> {
+  return new Message(
+    MessageOrigin.ChargingStation,
+    EventGroup.SmartCharging,
+    action,
+    MessageState.Request,
+    {
+      correlationId: 'corr-001',
+      tenantId: DEFAULT_TENANT_ID,
+      ocppConnectionName: STATION,
+      timestamp: new Date().toISOString(),
+    },
+    payload,
+    protocol,
+  );
+}
+
+/** IChargingLimitRepository in memory, keeping the contract both ORM implementations keep. */
+class FakeChargingLimitRepository implements IChargingLimitRepository {
+  rows: ChargingLimitDto[] = [];
+  private _nextId = 1;
+
+  createByStationId = vi.fn(
+    async (
+      tenantId: number,
+      value: OCPP2_request_types.NotifyChargingLimitRequest,
+      ocppConnectionName: string,
+    ): Promise<ChargingLimitDto> => {
+      const stationId = this.resolve(ocppConnectionName);
+      const evseId = value.evseId ?? null;
+      const source = value.chargingLimit.chargingLimitSource;
+      this.deactivate(
+        (row) =>
+          row.tenantId === tenantId &&
+          row.stationId === stationId &&
+          (row.evseId ?? null) === evseId &&
+          row.chargingLimitSource === source,
+      );
+      const row: ChargingLimitDto = {
+        id: this._nextId++,
+        tenantId,
+        stationId,
+        evseId,
+        chargingLimitSource: source,
+        isGridCritical: value.chargingLimit.isGridCritical ?? null,
+        isLocalGeneration:
+          'isLocalGeneration' in value.chargingLimit
+            ? (value.chargingLimit.isLocalGeneration ?? null)
+            : null,
+        chargingSchedule: value.chargingSchedule ?? null,
+        isActive: true,
+        clearedAt: null,
+      };
+      this.rows.push(row);
+      return row;
+    },
+  );
+
+  clearByStationId = vi.fn(
+    async (
+      tenantId: number,
+      value: OCPP2_request_types.ClearedChargingLimitRequest,
+      ocppConnectionName: string,
+    ): Promise<number> => {
+      const stationId = this.resolve(ocppConnectionName);
+      return this.deactivate(
+        (row) =>
+          row.tenantId === tenantId &&
+          row.stationId === stationId &&
+          row.chargingLimitSource === value.chargingLimitSource &&
+          (value.evseId == null || row.evseId === value.evseId),
+      );
+    },
+  );
+
+  active(): ChargingLimitDto[] {
+    return this.rows.filter((row) => row.isActive);
+  }
+
+  private resolve(ocppConnectionName: string): number {
+    if (ocppConnectionName !== STATION) {
+      throw new Error(`no charging station named '${ocppConnectionName}'`);
+    }
+    return STATION_ID;
+  }
+
+  private deactivate(matches: (row: ChargingLimitDto) => boolean): number {
+    let count = 0;
+    for (const row of this.rows) {
+      if (row.isActive && matches(row)) {
+        row.isActive = false;
+        row.clearedAt = new Date().toISOString();
+        count++;
+      }
+    }
+    return count;
+  }
+}
+
+function makeDeps() {
+  const { logger } = createTestContainer();
+  const ocppSender = makeMockOcppSender();
+  const chargingLimitRepository = new FakeChargingLimitRepository();
+  return { logger, ocppSender, chargingLimitRepository };
+}
+
+function sentResponse(
+  ocppSender: ReturnType<typeof makeMockOcppSender>,
+  message: Message<OcppRequest>,
+) {
+  expect(ocppSender.sendCallResultWithMessage).toHaveBeenCalledOnce();
+  expect(ocppSender.sendCallResultWithMessage.mock.calls[0][0]).toBe(message);
+  return ocppSender.sendCallResultWithMessage.mock.calls[0][1];
+}
+
+const schedule: OCPP2_1.NotifyChargingLimitRequest['chargingSchedule'] = [
+  {
+    id: 1,
+    chargingRateUnit: OCPP2_1.ChargingRateUnitEnumType.W,
+    chargingSchedulePeriod: [{ startPeriod: 0, limit: 7400 }],
+  },
+];
+
+describe('NotifyChargingLimitRequestOcpp2Handler', () => {
+  let deps: ReturnType<typeof makeDeps>;
+  let handler: NotifyChargingLimitRequestOcpp2Handler;
+
+  beforeEach(() => {
+    deps = makeDeps();
+    handler = new NotifyChargingLimitRequestOcpp2Handler(deps);
+  });
+
+  it('stores an OCPP 2.1 limit as active and answers {}', async () => {
+    const payload: OCPP2_1.NotifyChargingLimitRequest = {
+      evseId: 1,
+      chargingLimit: { chargingLimitSource: 'EMS', isGridCritical: true, isLocalGeneration: true },
+      chargingSchedule: schedule,
+    };
+    const message = aMessage(payload, OCPP_CallAction.NotifyChargingLimit);
+
+    await handler.handle(message);
+
+    expect(deps.chargingLimitRepository.createByStationId).toHaveBeenCalledWith(
+      DEFAULT_TENANT_ID,
+      payload,
+      STATION,
+    );
+    expect(deps.chargingLimitRepository.active()).toEqual([
+      expect.objectContaining({
+        stationId: STATION_ID,
+        evseId: 1,
+        chargingLimitSource: 'EMS',
+        isGridCritical: true,
+        isLocalGeneration: true,
+        chargingSchedule: schedule,
+        isActive: true,
+        clearedAt: null,
+      }),
+    ]);
+    expect(sentResponse(deps.ocppSender, message)).toEqual({});
+  });
+
+  it('stores an OCPP 2.0.1 limit for the whole station without isLocalGeneration', async () => {
+    const payload: OCPP2_0_1.NotifyChargingLimitRequest = {
+      chargingLimit: { chargingLimitSource: OCPP2_0_1.ChargingLimitSourceEnumType.SO },
+    };
+    const message = aMessage(payload, OCPP_CallAction.NotifyChargingLimit, OCPPVersion.OCPP2_0_1);
+
+    await handler.handle(message);
+
+    expect(deps.chargingLimitRepository.active()).toEqual([
+      expect.objectContaining({
+        evseId: null,
+        chargingLimitSource: 'SO',
+        isLocalGeneration: null,
+        chargingSchedule: null,
+      }),
+    ]);
+    expect(sentResponse(deps.ocppSender, message)).toEqual({});
+  });
+
+  it('deactivates the previous limit from the same source and EVSE before inserting', async () => {
+    const repo = deps.chargingLimitRepository;
+    const notify = (evseId: number | undefined, chargingLimitSource: string) =>
+      handler.handle(
+        aMessage<OCPP2_1.NotifyChargingLimitRequest>(
+          { evseId, chargingLimit: { chargingLimitSource } },
+          OCPP_CallAction.NotifyChargingLimit,
+        ),
+      );
+
+    await notify(1, 'EMS');
+    await notify(2, 'EMS');
+    await notify(1, 'SO');
+    await notify(undefined, 'EMS');
+    await notify(1, 'EMS');
+
+    const [first, ...rest] = repo.rows;
+    expect(first).toEqual(
+      expect.objectContaining({ evseId: 1, chargingLimitSource: 'EMS', isActive: false }),
+    );
+    expect(first.clearedAt).toEqual(expect.any(String));
+    expect(rest.every((row) => row.isActive)).toBe(true);
+    expect(repo.active().map((row) => [row.evseId, row.chargingLimitSource])).toEqual([
+      [2, 'EMS'],
+      [1, 'SO'],
+      [null, 'EMS'],
+      [1, 'EMS'],
+    ]);
+  });
+
+  it('logs a storage failure and still answers {}', async () => {
+    const message = aMessage<OCPP2_1.NotifyChargingLimitRequest>(
+      { chargingLimit: { chargingLimitSource: 'EMS' } },
+      OCPP_CallAction.NotifyChargingLimit,
+    );
+    deps.chargingLimitRepository.createByStationId.mockRejectedValueOnce(new Error('db down'));
+
+    await handler.handle(message);
+
+    expect(deps.logger.error).toHaveBeenCalledWith(
+      'Failed to store charging limit',
+      expect.any(Error),
+    );
+    expect(sentResponse(deps.ocppSender, message)).toEqual({});
+    expect(deps.ocppSender.sendCallErrorWithMessage).not.toHaveBeenCalled();
+  });
+});
+
+describe('ClearedChargingLimitRequestOcpp2Handler', () => {
+  let deps: ReturnType<typeof makeDeps>;
+  let handler: ClearedChargingLimitRequestOcpp2Handler;
+
+  async function seed(evseId: number | undefined, chargingLimitSource: string) {
+    await deps.chargingLimitRepository.createByStationId(
+      DEFAULT_TENANT_ID,
+      { evseId, chargingLimit: { chargingLimitSource } },
+      STATION,
+    );
+  }
+
+  beforeEach(async () => {
+    deps = makeDeps();
+    handler = new ClearedChargingLimitRequestOcpp2Handler(
+      mockDeps<typeof ClearedChargingLimitRequestOcpp2Handler>(deps),
+    );
+    await seed(1, 'EMS');
+    await seed(2, 'EMS');
+    await seed(1, 'SO');
+  });
+
+  it('clears the source on the given EVSE only and answers {}', async () => {
+    const payload: OCPP2_1.ClearedChargingLimitRequest = {
+      chargingLimitSource: OCPP2_1.ChargingLimitSourceEnumType.EMS,
+      evseId: 1,
+    };
+    const message = aMessage(payload, OCPP_CallAction.ClearedChargingLimit);
+
+    await handler.handle(message);
+
+    expect(deps.chargingLimitRepository.clearByStationId).toHaveBeenCalledWith(
+      DEFAULT_TENANT_ID,
+      payload,
+      STATION,
+    );
+    expect(
+      deps.chargingLimitRepository.active().map((row) => [row.evseId, row.chargingLimitSource]),
+    ).toEqual([
+      [2, 'EMS'],
+      [1, 'SO'],
+    ]);
+    expect(sentResponse(deps.ocppSender, message)).toEqual({});
+  });
+
+  it('clears the source on every EVSE when evseId is absent', async () => {
+    const message = aMessage<OCPP2_0_1.ClearedChargingLimitRequest>(
+      { chargingLimitSource: OCPP2_0_1.ChargingLimitSourceEnumType.EMS },
+      OCPP_CallAction.ClearedChargingLimit,
+      OCPPVersion.OCPP2_0_1,
+    );
+
+    await handler.handle(message);
+
+    expect(
+      deps.chargingLimitRepository.active().map((row) => [row.evseId, row.chargingLimitSource]),
+    ).toEqual([[1, 'SO']]);
+    expect(sentResponse(deps.ocppSender, message)).toEqual({});
+  });
+
+  it('logs a storage failure and still answers {}', async () => {
+    const message = aMessage<OCPP2_1.ClearedChargingLimitRequest>(
+      { chargingLimitSource: OCPP2_1.ChargingLimitSourceEnumType.SO },
+      OCPP_CallAction.ClearedChargingLimit,
+    );
+    deps.chargingLimitRepository.clearByStationId.mockRejectedValueOnce(new Error('db down'));
+
+    await handler.handle(message);
+
+    expect(deps.logger.error).toHaveBeenCalledWith(
+      'Failed to clear charging limit',
+      expect.any(Error),
+    );
+    expect(deps.chargingLimitRepository.active()).toHaveLength(3);
+    expect(sentResponse(deps.ocppSender, message)).toEqual({});
+  });
+});
