@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: 2026 Contributors to the CitrineOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+// ha-citrine patch (0005-ocpp2-route-schema-definitions)
+import { OCPP2_0_1, OCPP2_1 } from '@citrineos/types';
+import Fastify, { type FastifyInstance } from 'fastify';
+import { Logger, type ILogObj } from 'tslog';
+import { describe, expect, it } from 'vitest';
+import { registerRouteSchema } from '@base-util/endpoints/route-schemas.js';
+
+const logger = new Logger<ILogObj>({ type: 'hidden' });
+
+function profile(purpose: string) {
+  return {
+    evseId: 0,
+    chargingProfile: {
+      id: 9100,
+      stackLevel: 1,
+      chargingProfilePurpose: purpose,
+      chargingProfileKind: 'Relative',
+      chargingSchedule: [
+        { id: 1, chargingRateUnit: 'W', chargingSchedulePeriod: [{ startPeriod: 0, limit: 3000 }] },
+      ],
+    },
+  };
+}
+
+async function server(): Promise<FastifyInstance> {
+  const app = Fastify();
+  const targets = { scoped: app, root: app, logger };
+  // Registered in the order the message API registers them: 2.0.1, then 2.1.
+  for (const [version, schema] of [
+    ['ocpp2.0.1', OCPP2_0_1.SetChargingProfileRequestSchema],
+    ['ocpp2.1', OCPP2_1.SetChargingProfileRequestSchema],
+  ] as const) {
+    const body = registerRouteSchema(targets, schema, `${version}-`);
+    app.post(`/${version}`, { schema: { body: body ?? undefined } }, async () => ({ ok: true }));
+  }
+  await app.ready();
+  return app;
+}
+
+describe('registerRouteSchema with version prefixes', () => {
+  it('validates each version against its own definitions', async () => {
+    const app = await server();
+    const post = (url: string, purpose: string) =>
+      app.inject({ method: 'POST', url, payload: profile(purpose) });
+
+    // LocalGeneration is an OCPP 2.1 purpose only.
+    expect((await post('/ocpp2.1', 'LocalGeneration')).statusCode).toBe(200);
+    expect((await post('/ocpp2.0.1', 'LocalGeneration')).statusCode).toBe(400);
+    expect((await post('/ocpp2.0.1', 'TxDefaultProfile')).statusCode).toBe(200);
+    expect((await post('/ocpp2.1', 'TxDefaultProfile')).statusCode).toBe(200);
+    await app.close();
+  });
+});
