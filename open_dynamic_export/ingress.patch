diff --git a/src/ui/ingress.ts b/src/ui/ingress.ts
new file mode 100644
index 0000000..e93ad0d
--- /dev/null
+++ b/src/ui/ingress.ts
@@ -0,0 +1,7 @@
+// Home Assistant ingress serves this UI under /api/hassio_ingress/<token>/
+// and forwards requests without that prefix. Detect the prefix in the
+// browser so client routes (and so NextUI link hrefs, which are built with
+// router.buildLocation) and API calls stay inside it.
+const match = /^\/api\/hassio_ingress\/[^/]+/.exec(window.location.pathname);
+
+export const basePath = match ? match[0] : '';
