+    // Several programs can share the lowest primacy, and a program's DefaultDERControl may set
+    // only some controls or none (CSIP-AUS GEN-10 has five programs at one primacy, and only one
+    // has a default). Take each control from the highest-priority default that sets it, so an
+    // empty default does not hide another program's values.
+    const derControlBase: DefaultDERControl['derControlBase'] = {};
+    let setGradW: number | undefined;
+    let setSoftGradW: number | undefined;
+    let source: MergedDefaultControlsData | undefined;
+
+    for (const data of sortedDefaultDerControl) {
+        const base = data.defaultControl.derControlBase;
+        let contributed = false;
+
+        for (const key of defaultControlKeys) {
+            if (derControlBase[key] === undefined && base[key] !== undefined) {
+                // oxlint-disable-next-line @typescript-eslint/no-explicit-any
+                (derControlBase as Record<string, any>)[key] = base[key];
+                contributed = true;
+            }
+        }
+
+        if (contributed) {
+            source ??= data;
+            setGradW ??= data.defaultControl.setGradW;
+            setSoftGradW ??= data.defaultControl.setSoftGradW;
+        }
+    }
+
+    if (!source) {
+        return { type: 'default', data: firstDefaultDerControl };
+    }
+
+    return {
+        type: 'default',
+        data: {
+            ...source,
+            defaultControl: {
+                ...source.defaultControl,
+                derControlBase,
+                setGradW,
+                setSoftGradW,
+            },
+        },
+    };
 }
 
