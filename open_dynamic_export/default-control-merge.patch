+
+describe('DerControlsHelper default control', () => {
+    function defaultControl(
+        derControlBase: DefaultDERControl['derControlBase'],
+        setGradW?: number,
+    ): DefaultDERControl {
+        return {
+            mRID: randomUUID(),
+            href: '/dderc',
+            subscribable: true,
+            version: 0,
+            derControlBase,
+            setGradW,
+        };
+    }
+
+    function fallbackFor(
+        programs: {
+            primacy: number;
+            defaultDerControl?: DefaultDERControl;
+        }[],
+    ) {
+        const derControlsHelper = new DerControlsHelper({
+            client: sep2Client,
+        });
+        let fallback: FallbackControl | undefined;
+        derControlsHelper.on('data', (data) => {
+            fallback = data.fallbackControl;
+        });
+
+        derControlsHelper.updateFsaData([
+            {
+                functionSetAssignments: generateMockFunctionSetAssignments({}),
+                derProgramList: programs.map(
+                    ({ primacy, defaultDerControl }) => ({
+                        program: generateMockDERProgram({ primacy }),
+                        defaultDerControl,
+                        derControls: [],
+                    }),
+                ),
+            },
+        ]);
+
+        return fallback;
+    }
+
+    it('skips an empty default at the same primacy (CSIP-AUS GEN-10)', () => {
+        const withValues = defaultControl(
+            {
+                opModImpLimW: { value: 0, multiplier: 0 },
+                opModExpLimW: { value: 3000, multiplier: 0 },
+            },
+            167,
+        );
+        const fallback = fallbackFor([
+            { primacy: 1, defaultDerControl: defaultControl({}) },
+            { primacy: 1, defaultDerControl: defaultControl({}) },
+            { primacy: 1, defaultDerControl: withValues },
+            {
+                primacy: 2,
+                defaultDerControl: defaultControl({
+                    opModImpLimW: { value: 0, multiplier: 0 },
+                    opModExpLimW: { value: 0, multiplier: 0 },
+                }),
+            },
+        ]);
+
+        expect(fallback?.type).toBe('default');
+        if (fallback?.type !== 'default') return;
+        expect(fallback.data.defaultControl.mRID).toBe(withValues.mRID);
+        expect(fallback.data.defaultControl.derControlBase).toEqual({
+            opModImpLimW: { value: 0, multiplier: 0 },
+            opModExpLimW: { value: 3000, multiplier: 0 },
+        });
+        expect(fallback.data.defaultControl.setGradW).toBe(167);
+    });
+
+    it('takes each control from the highest priority default that sets it', () => {
+        const fallback = fallbackFor([
+            {
+                primacy: 2,
+                defaultDerControl: defaultControl({
+                    opModImpLimW: { value: 5000, multiplier: 0 },
+                    opModExpLimW: { value: 2000, multiplier: 0 },
+                }),
+            },
+            {
+                primacy: 1,
+                defaultDerControl: defaultControl({
+                    opModExpLimW: { value: 5000, multiplier: 0 },
+                }),
+            },
+        ]);
+
+        expect(fallback?.type).toBe('default');
+        if (fallback?.type !== 'default') return;
+        expect(fallback.data.defaultControl.derControlBase).toEqual({
+            opModExpLimW: { value: 5000, multiplier: 0 },
+            opModImpLimW: { value: 5000, multiplier: 0 },
+        });
+    });
+
+    it('keeps the first default when none sets a control', () => {
+        const empty = defaultControl({});
+        const fallback = fallbackFor([
+            { primacy: 2, defaultDerControl: defaultControl({}) },
+            { primacy: 1, defaultDerControl: empty },
+        ]);
+
+        expect(fallback?.type).toBe('default');
+        if (fallback?.type !== 'default') return;
+        expect(fallback.data.defaultControl.mRID).toBe(empty.mRID);
+        expect(fallback.data.defaultControl.derControlBase).toEqual({});
+    });
+
+    it('is none without any default', () => {
+        expect(fallbackFor([{ primacy: 1 }])).toEqual({ type: 'none' });
+    });
+});
